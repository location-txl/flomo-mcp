{
  "name": "@location-txl/flomo-mcp",
  "version": "0.2.0",
  "description": "MCP server for flomo notes: reuse the desktop app's login session via CDP to search, write and edit notes",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "flomo-mcp": "dist/index.js",
    "flomo-mcp-patch": "scripts/patch-flomo.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "AGENT.md",
    "TOOLS.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "patch-flomo": "node scripts/patch-flomo.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flomo",
    "mcp",
    "notes",
    "model-context-protocol",
    "ai",
    "claude"
  ],
  "engines": {
    "node": ">=22.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/location-txl/flomo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/location-txl/flomo-mcp/issues"
  },
  "homepage": "https://github.com/location-txl/flomo-mcp#readme",
  "dependencies": {
    "@electron/asar": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
